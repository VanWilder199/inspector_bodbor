{
  "name": "@podbor/inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "VITE_API_MOCKS=1 vite",
    "tunnel": "VITE_TUNNEL=1 vite",
    "build": "tsc --noEmit -p . && vite build",
