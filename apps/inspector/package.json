    "test:watch": "vitest",
    "preview": "vite preview",
    "sign-init-data": "node --experimental-strip-types scripts/sign-init-data.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@podbor/ui": "*",
    "@tanstack/query-sync-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@telegram-apps/telegram-ui": "^2.1.13",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^7.18.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^20.14.5",
    "msw": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
