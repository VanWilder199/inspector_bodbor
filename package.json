{
  "name": "podbor-inspector",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @podbor/inspector",
    "dev:mocks": "npm run dev:mocks -w @podbor/inspector",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}