# Переменные для docker compose (BOT-04). Скопируйте в `.env` и заполните.

# ---- Обязательные ----
# Токен бота от @BotFather. Должен совпадать с TELEGRAM_BOT_TOKEN бэкенда, иначе подпись initData не сойдётся.
TELEGRAM_BOT_TOKEN=
# Публичный домен, на котором живёт Mini App (без http://). Для туннеля — <sub>.trycloudflare.com.
PUBLIC_HOST=app.site.by

# ---- Опциональные (есть значения по умолчанию) ----
# Юзернейм бота для MINIAPP_DIRECT_LINK (без @).
BOT_USERNAME=inspector_bodbor_bot
# Прямая ссылка Mini App; по умолчанию собирается из BOT_USERNAME.
MINIAPP_DIRECT_LINK=
# Полный адрес Mini App; по умолчанию https://app.${PUBLIC_HOST}.
MINIAPP_URL=
# Порт, на который nginx публикует SPA (по умолчанию 8081).
APP_PORT=8081
# true — работать с тестовым окружением Telegram.
TELEGRAM_TEST_ENV=false
LOG_LEVEL=INFO

# ---- Локальная разработка (профиль `local`), не для прода ----
# S3, который бэкенд использует для загрузок. В проде — внешний S3 (hoster.by); MinIO только локально.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=inspector-bodbor
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Образ бэкенда (предусловие, не часть BOT-04).
API_IMAGE=backend-podbor-api:latest